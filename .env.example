# Environment
NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# PostgreSQL connection string used by Prisma
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastify_backend_template?schema=public"

# JWT secrets — generate strong random values for real environments,
# e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_REFRESH_EXPIRES_IN=7d

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastify_backend_template
